{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "description": "검증 Step 의 조건.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AssertionKind"
        },
        "match": {
          "$ref": "#/$defs/MatchMode",
          "default": "equals"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "target",
        "match",
        "value"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "AssertionKind": {
      "enum": [
        "visible",
        "hidden",
        "text",
        "url"
      ],
      "title": "AssertionKind",
      "type": "string"
    },
    "AssertionStep": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "$ref": "#/$defs/Assertion"
        },
        "author": {
          "$ref": "#/$defs/Author",
          "default": "human"
        },
        "frame_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Url"
        },
        "id": {
          "pattern": "^step-\\d{2,}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "tab": {
          "default": 0,
          "minimum": 0,
          "title": "Tab",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 10000,
          "maximum": 60000,
          "minimum": 1,
          "title": "Timeout Ms",
