{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "description": "검증 Step 의 조건.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AssertionKind"
        },
        "match": {
          "$ref": "#/$defs/MatchMode",
          "default": "equals"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "target",
        "match",
        "value"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "AssertionKind": {
      "enum": [
        "visible",
        "hidden",
        "text",
        "url"
      ],
      "title": "AssertionKind",
      "type": "string"
    },
    "AssertionStep": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "$ref": "#/$defs/Assertion"
        },
        "author": {
          "$ref": "#/$defs/Author",
          "default": "human"
        },
        "frame_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Url"
        },
        "id": {
          "pattern": "^step-\\d{2,}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "tab": {
          "default": 0,
          "minimum": 0,
          "title": "Tab",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 5000,
          "maximum": 60000,
          "minimum": 1,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "type": {
          "const": "assertion",
          "default": "assertion",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "author",
        "tab",
        "timeout_ms",
        "frame_url",
        "type",
        "assertion"
      ],
      "title": "AssertionStep",
      "type": "object"
    },
    "Author": {
      "enum": [
        "human",
        "ai"
      ],
      "title": "Author",
      "type": "string"
    },
    "Candidate": {
      "additionalProperties": false,
      "description": "식별 후보 하나.",
      "properties": {
        "status": {
          "$ref": "#/$defs/CandidateStatus"
        },
        "value": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "status"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CandidateStatus": {
      "description": "기록 시점 검증 결과. research R4 실측으로 ``AMBIGUOUS`` 가 추가됐다.",
      "enum": [
        "verified",
        "ambiguous",
        "unverified",
        "not_collected"
      ],
      "title": "CandidateStatus",
      "type": "string"
    },
    "ClickStep": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "$ref": "#/$defs/Author",
          "default": "human"
        },
        "frame_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Url"
        },
        "id": {
          "pattern": "^step-\\d{2,}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "tab": {
          "default": 0,
          "minimum": 0,
          "title": "Tab",
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/TargetLocator"
        },
        "timeout_ms": {
          "default": 5000,
          "maximum": 60000,
          "minimum": 1,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "type": {
          "const": "click",
          "default": "click",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "author",
        "tab",
        "timeout_ms",
        "frame_url",
        "type",
        "target"
      ],
      "title": "ClickStep",
      "type": "object"
    },
    "CloseTabStep": {
      "additionalProperties": false,
      "description": "탭 닫기 (FR-030c). 대상은 공통 ``tab`` 필드가 가리킨다.",
      "properties": {
        "author": {
          "$ref": "#/$defs/Author",
          "default": "human"
        },
        "frame_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Url"
        },
        "id": {
          "pattern": "^step-\\d{2,}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "tab": {
          "default": 0,
          "minimum": 0,
          "title": "Tab",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 5000,
          "maximum": 60000,
          "minimum": 1,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "type": {
          "const": "close_tab",
          "default": "close_tab",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "author",
        "tab",
        "timeout_ms",
        "frame_url",
        "type"
      ],
      "title": "CloseTabStep",
      "type": "object"
    },
    "FillStep": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "$ref": "#/$defs/Author",
          "default": "human"
        },
        "frame_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Url"
        },
        "id": {
          "pattern": "^step-\\d{2,}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "tab": {
          "default": 0,
          "minimum": 0,
          "title": "Tab",
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/TargetLocator"
        },
        "timeout_ms": {
          "default": 5000,
