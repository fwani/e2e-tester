        },
        "value": {
          "maxLength": 4000,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "author",
        "tab",
        "timeout_ms",
        "frame_url",
        "type",
        "target",
        "value"
      ],
      "title": "FillStep",
      "type": "object"
    },
    "MatchMode": {
      "enum": [
        "equals",
        "contains"
      ],
      "title": "MatchMode",
      "type": "string"
    },
    "NavigateStep": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "$ref": "#/$defs/Author",
          "default": "human"
        },
        "frame_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Url"
        },
        "id": {
          "pattern": "^step-\\d{2,}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "tab": {
          "default": 0,
          "minimum": 0,
          "title": "Tab",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 5000,
          "maximum": 60000,
          "minimum": 1,
          "title": "Timeout Ms",
