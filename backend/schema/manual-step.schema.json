{
  "$defs": {
    "AssertTextSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "assert_text",
          "default": "assert_text",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "match": {
          "$ref": "#/$defs/MatchMode",
          "default": "contains"
        },
        "tab": {
          "default": 0,
          "minimum": 0,
          "title": "Tab",
          "type": "integer"
        },
        "timeout_ms": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Ms"
        },
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tab",
        "timeout_ms",
        "kind",
        "value",
        "match"
      ],
      "title": "AssertTextSpec",
      "type": "object"
    },
