{
  "$defs": {
    "BrowserKind": {
      "enum": [
        "chromium"
      ],
      "title": "BrowserKind",
      "type": "string"
    },
    "TestGroup": {
      "additionalProperties": false,
      "description": "한 프로젝트 안에서 테스트를 묶는 것 (013 FR-438·FR-444d).\n\n**보이는 이름과 식별자 접두어를 따로 갖는다.** 이름은 사람이 읽는 것이고\n(「사용자관리 테스트」), 접두어는 식별자에 들어가는 짧은 값이다 (`USER`). 이름에서\n접두어를 자동으로 뽑지 않는 이유는 이름이 한글일 수 있기 때문이다 — 그대로 쓰면\n식별자가 `사용자관리-001` 로 길어지고, 로마자로 바꾸면 사용자가 예측하지 못하는 값이\n나온다 (013 clarify).\n\n**소속을 테스트에 저장하지 않는다.** 식별자의 접두어가 곧 소속이다 — 둘을 다 저장하면\n어긋날 수 있고, 어긋났을 때 어느 쪽이 맞는지 정할 근거가 없다 (013 data-model §3).",
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "prefix": {
          "pattern": "^[A-Z][A-Z0-9]{0,7}$",
          "title": "Prefix",
          "type": "string"
        }
      },
      "required": [
        "prefix",
        "name"
      ],
      "title": "TestGroup",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "테스트를 담는 최상위 단위. 프로젝트 하나 = 디렉터리 하나.",
  "properties": {
    "browser": {
      "$ref": "#/$defs/BrowserKind",
      "default": "chromium"
    },
    "default_start_url": {
      "maxLength": 2000,
      "pattern": "^https?://",
      "title": "Default Start Url",
      "type": "string"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/TestGroup"
      },
      "title": "Groups",
      "type": "array"
    },
    "max_tabs": {
      "default": 10,
      "maximum": 50,
      "minimum": 1,
      "title": "Max Tabs",
      "type": "integer"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "next_test_number": {
      "default": 1,
      "maximum": 999,
      "minimum": 1,
      "title": "Next Test Number",
      "type": "integer"
    },
    "test_id_attribute": {
      "default": "data-testid",
      "maxLength": 100,
      "minLength": 1,
      "title": "Test Id Attribute",
      "type": "string"
    }
  },
  "required": [
    "name",
    "default_start_url",
    "browser",
    "test_id_attribute",
    "next_test_number",
    "max_tabs",
    "groups"
  ],
  "title": "Project",
  "type": "object"
}
