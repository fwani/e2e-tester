        "author",
        "tab",
        "timeout_ms",
        "frame_url",
        "type",
        "target",
        "value"
      ],
      "title": "SelectStep",
      "type": "object"
    },
    "StableAttr": {
      "additionalProperties": false,
      "description": "`[name=\"value\"]` 형태로 쓰는 안정적 속성.",
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CandidateStatus"
        },
        "value": {
          "maxLength": 2000,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "status"
      ],
      "title": "StableAttr",
      "type": "object"
    },
    "TargetLocator": {
      "additionalProperties": false,
      "description": "한 요소에 대한 식별 후보 묶음.\n\n**불변식**: 후보가 하나도 없는 ``TargetLocator`` 는 유효하지 않다.\n최소한 ``css`` 는 항상 수집된다.",
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "css": {
          "anyOf": [
            {
              "$ref": "#/$defs/Candidate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Candidate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "role_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stable_attr": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableAttr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tag": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        },
        "test_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Candidate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/Candidate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "tag",
        "test_id",
        "role",
        "accessible_name",
        "role_status",
        "label",
        "text",
        "stable_attr",
        "css"
      ],
      "title": "TargetLocator",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "assertion": "#/$defs/AssertionStep",
      "click": "#/$defs/ClickStep",
      "close_tab": "#/$defs/CloseTabStep",
      "fill": "#/$defs/FillStep",
      "navigate": "#/$defs/NavigateStep",
      "select": "#/$defs/SelectStep"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ClickStep"
    },
    {
      "$ref": "#/$defs/FillStep"
    },
    {
      "$ref": "#/$defs/SelectStep"
    },
    {
      "$ref": "#/$defs/NavigateStep"
    },
    {
      "$ref": "#/$defs/AssertionStep"
    },
    {
      "$ref": "#/$defs/CloseTabStep"
    }
  ],
  "title": "step"
}
