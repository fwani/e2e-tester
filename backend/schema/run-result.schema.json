{
  "$defs": {
    "Artifacts": {
      "additionalProperties": false,
      "properties": {
        "console_log": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Console Log"
        },
        "failure_screenshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Screenshot"
        },
        "network_log": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network Log"
        },
        "trace": {
          "default": null,
          "title": "Trace",
          "type": "null"
        }
      },
      "required": [
        "failure_screenshot",
        "console_log",
        "network_log",
        "trace"
      ],
      "title": "Artifacts",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "PROJECT_NOT_OPEN",
        "PROJECT_ALREADY_EXISTS",
        "PROJECT_NOT_FOUND",
        "INVALID_PATH",
        "TEST_NOT_FOUND",
        "STEP_LIST_EMPTY",
        "DEFINITION_INVALID",
        "DEFINITION_STALE",
        "SESSION_NOT_FOUND",
        "SESSION_ALREADY_ACTIVE",
        "SESSION_LOST",
        "NOT_PAUSED",
        "CANNOT_RESUME_PAST_FAILURE",
        "INVALID_TRANSITION",
        "TAB_NOT_FOUND",
        "TAB_LIMIT_REACHED",
        "KEY_MISSING",
        "KEY_ALREADY_EXISTS",
        "PASSPHRASE_REQUIRED",
        "PASSPHRASE_INVALID",
        "DECRYPT_FAILED",
        "FINGERPRINT_MISMATCH",
        "SECRET_NOT_FOUND",
        "STEP_FAILED",
        "TARGET_UNREACHABLE",
        "ELEMENT_NOT_READY",
        "ELEMENT_AMBIGUOUS",
        "AI_FAILED",
        "STORAGE_WRITE_FAILED",
        "NOT_SUPPORTED",
        "INTERNAL_ERROR"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "LocatorAttempt": {
      "additionalProperties": false,
      "description": "요소 탐색 시도 하나. RunResult 화면의 \"시도한 LOCATOR (우선순위 순)\" 에 대응한다.",
      "properties": {
        "candidate": {
          "title": "Candidate",
          "type": "string"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "match_count": {
          "default": 0,
          "minimum": 0,
          "title": "Match Count",
          "type": "integer"
        },
        "matched": {
          "title": "Matched",
          "type": "boolean"
        },
        "waited_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Waited Ms",
          "type": "integer"
        }
      },
      "required": [
        "candidate",
        "expression",
        "matched",
        "match_count",
        "waited_ms"
      ],
      "title": "LocatorAttempt",
      "type": "object"
    },
    "Outcome": {
      "description": "실행이 어떻게 끝났는가 (005 FR-131·FR-137).\n\n**네 값이 필요한 이유는 두 값이 서로 다른 것을 뭉갰기 때문이다.** 사용자가 누른 중지가\n`FAIL` 로 기록되어 사고처럼 보이고(U-03), 실패 Step 을 건너뛴 실행이 통과처럼 보였다\n(U-05).\n\n판정 우선순위는 `decide_outcome()` 이 갖는다. 여기서 값을 늘리기만 하고 판정을 여러\n곳에 흩으면 화면과 저장된 결과가 다시 어긋난다.",
      "enum": [
        "pass",
        "fail",
        "stopped",
        "partial_pass"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "RunScope": {
      "description": "이 실행이 전체였는가 부분이었는가 (005 FR-152).\n\n결말과 **다른 축**이다. Step 06~07 만 돌아 전부 통과하면 결말은 `PASS` 이고 범위가\n`PARTIAL` 이다. 한 값에 섞으면 \"부분 구간을 전부 통과한 실행\" 을 부를 이름이 없어진다.",
      "enum": [
        "full",
        "partial"
      ],
      "title": "RunScope",
      "type": "string"
    },
    "StepOutcome": {
      "enum": [
        "pass",
        "fail",
        "skipped",
        "not_run"
      ],
      "title": "StepOutcome",
      "type": "string"
    },
    "StepResult": {
      "additionalProperties": false,
      "properties": {
        "candidate_disagreement": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Disagreement",
          "type": "array"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "element_wait_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Element Wait Ms",
          "type": "integer"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "locator_attempts": {
          "items": {
            "$ref": "#/$defs/LocatorAttempt"
          },
          "title": "Locator Attempts",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/StepOutcome"
        },
        "resolved_candidate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Candidate"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "tab": {
          "default": 0,
          "minimum": 0,
          "title": "Tab",
          "type": "integer"
        },
        "tab_wait_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Tab Wait Ms",
          "type": "integer"
        }
      },
      "required": [
        "step_id",
        "index",
        "label",
        "outcome",
        "duration_ms",
        "tab",
        "tab_wait_ms",
        "error_code",
        "element_wait_ms",
        "resolved_candidate",
        "locator_attempts",
        "error_message",
        "candidate_disagreement"
      ],
      "title": "StepResult",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/Artifacts"
    },
    "attempted_count": {
      "default": 0,
      "minimum": 0,
      "title": "Attempted Count",
      "type": "integer"
    },
    "browser": {
      "title": "Browser",
      "type": "string"
    },
    "failed_step_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failed Step Index"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "passed_count": {
      "minimum": 0,
      "title": "Passed Count",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/RunScope",
      "default": "full"
    },
    "session_lost": {
      "default": false,
      "title": "Session Lost",
      "type": "boolean"
    },
    "start_index": {
      "default": 0,
      "minimum": 0,
      "title": "Start Index",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepResult"
      },
      "title": "Steps",
      "type": "array"
    },
    "stopped_step_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stopped Step Index"
    },
    "test_id": {
      "title": "Test Id",
      "type": "string"
    },
    "total_count": {
      "minimum": 0,
      "title": "Total Count",
      "type": "integer"
    },
    "total_ms": {
      "minimum": 0,
      "title": "Total Ms",
      "type": "integer"
    }
  },
  "required": [
    "test_id",
    "outcome",
    "started_at",
    "finished_at",
    "total_ms",
    "passed_count",
    "total_count",
    "failed_step_index",
    "browser",
    "steps",
    "artifacts",
    "session_lost",
    "start_index",
    "scope",
    "attempted_count",
    "stopped_step_index"
  ],
  "title": "RunResult",
  "type": "object"
}
