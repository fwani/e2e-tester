    "SelectStep": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "$ref": "#/$defs/Author",
          "default": "human"
        },
        "frame_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
